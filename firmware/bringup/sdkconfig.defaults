# M5Stack Tab5 / ESP32-P4 bring-up. No Wi-Fi, no C6, no Octoooo partition.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# This machine is P4 rev v1.3. Detection still uses official BSP for panels.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_FREERTOS_HZ=1000

# USB JTAG console (303A:1001). Not /dev/cu.usbmodem01.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Official BSP I2C is the on-board bus (G31/G32), not the keyboard bus.
CONFIG_BSP_I2C_NUM=0
CONFIG_BSP_SD_FORMAT_ON_MOUNT_FAIL=n

CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Keep warnings visible.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
