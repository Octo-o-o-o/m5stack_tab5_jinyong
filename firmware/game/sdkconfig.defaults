# M5Stack Tab5 / ESP32-P4 game firmware. No Wi-Fi, no C6.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# This machine is P4 rev v1.3. Detection still uses official BSP for panels.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# 32 MB of PSRAM gets walked on every boot otherwise. Boot time only.
CONFIG_SPIRAM_MEMTEST=n
# C++ static ctors run before the 200KB+ high-DRAM startup heaps are
# enabled. Keep only tiny blocks in internal RAM so STL nodes go to PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_FREERTOS_HZ=1000
# CPU stays at 360 MHz. 400 MHz on P4 rev < 3.0 needs
# CONFIG_ESP_FORCE_400MHZ_ON_REV_LESS_V3, which IDF documents as only valid for
# chips Espressif separately qualified. This board is rev v1.3: not qualified.

# USB JTAG console (303A:1001). Not /dev/cu.usbmodem01.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_BSP_I2C_NUM=0
CONFIG_BSP_SD_FORMAT_ON_MOUNT_FAIL=n
# Second RGB565 FB (1.8MB). Draw off-screen and flip; do not add a 720p RGBA.
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=2

CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=4096

# Game init can load a lot of GRP before the first delay.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
